{
  "name": "quandle-action",
  "version": "1.1.0",
  "private": true,
  "description": "Quandle GitHub Action: outside-in check of every deploy",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --legal-comments=none --metafile=node_modules/.cache/quandle/esbuild-meta.json && node scripts/write-third-party-licenses.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:source": "node scripts/check-invisible-characters.mjs",
    "check:rules": "node scripts/check-rule-traceability.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "all": "npm run check:source && npm run check:rules && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
